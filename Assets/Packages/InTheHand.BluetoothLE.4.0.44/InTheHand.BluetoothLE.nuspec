<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>InTheHand.BluetoothLE</id>
    <version>4.0.44</version>
    <authors>Peter Foot</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>32feet-package-icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/inthehand/32feet</projectUrl>
    <description>32feet.NET is an open-source project to make personal area networking technologies such as Bluetooth easily accessible from .NET code.</description>
    <releaseNotes>Latest bug fixes.</releaseNotes>
    <copyright>Copyright (c) 2004-2025 In The Hand Ltd</copyright>
    <tags>bluetooth windows android ios tvos macos uwp linux</tags>
    <repository type="git" url="https://github.com/inthehand/32feet" branch="refs/heads/main" commit="0f9313e7b158744d614d8e279d398ce44b2e38ef" />
    <dependencies>
      <group targetFramework="MonoAndroid10.0">
        <dependency id="InTheHand.AndroidActivity" version="1.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="Xamarin.iOS1.0" />
      <group targetFramework="Xamarin.TVOS1.0" />
      <group targetFramework="Xamarin.WatchOS1.0" />
      <group targetFramework="net9.0">
        <dependency id="Linux.Bluetooth" version="5.67.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0-android35.0">
        <dependency id="InTheHand.AndroidActivity" version="1.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0-ios18.0" />
      <group targetFramework="net9.0-maccatalyst18.0" />
      <group targetFramework="net9.0-windows10.0.19041" />
      <group targetFramework=".NETStandard2.0" />
      <group targetFramework="UAP10.0.17763" />
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Java.Interop" targetFramework="MonoAndroid10.0" />
      <frameworkAssembly assemblyName="System.Drawing.Common.dll" targetFramework="Xamarin.iOS1.0, Xamarin.TVOS1.0, Xamarin.WatchOS1.0" />
    </frameworkAssemblies>
  </metadata>
</package>