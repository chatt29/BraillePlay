  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LessonManager
  quizManager: {fileID: 719558640}
  voiceAudioSource: {fileID: 725868524}
  welcomeAudio: {fileID: 8300000, guid: 0f70ca35b266ae74d9f6b3d7009d74ea, type: 3}
  letsLearnAudio: {fileID: 8300000, guid: 2ad7aa3fcb191cd4fa5ef3d62fb7d19b, type: 3}
  endOfLessonAudio: {fileID: 8300000, guid: 625732e2f9db2aa43b320a2470b6a204, type: 3}
  endOfLessonPromptMessage: You have completed the lesson. Press Space to begin the
    Quiz, or press R to rewatch the lesson.
  lessonPages:
  - title: 
    lessonText: Every word has two parts. The first part is the onset, which is the
      beginning sound. The second part is the rime, which is the rest of the word.
      In the word cat, c is the onset, and at is the rime.
    lessonAudio: {fileID: 8300000, guid: 13e703c54ddd86343b5724c92d4f3326, type: 3}
  - title: 
    lessonText: "Let\u2019s listen to the at family. Cat. Hat. Bat. Sat. Mat. Each
      word ends the same way, with at, but starts with a different sound."
    lessonAudio: {fileID: 8300000, guid: 2c38637c396a7b34bb00f72097a72f54, type: 3}
  - title: 
    lessonText: "Here\u2019s the ig family. Big. Pig. Dig. Wig. Fig. The ending stays
      the same, but the onset changes."
    lessonAudio: {fileID: 8300000, guid: a6c1acd50b02084479ccaf9493ccfbc1, type: 3}
  delayAfterVoice: 0.35
  noAudioFallbackDelay: 2
  logDebug: 1
