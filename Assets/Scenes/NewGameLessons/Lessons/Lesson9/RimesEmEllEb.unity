  - title: What is an Initial?
    categoryLabel: LESSON
    lessonImage: {fileID: 0}
    pageType: 0
    informationBeats:
    - message: Every word begins with an initial.
      audio: {fileID: 8300000, guid: 4daf0f7d040395e4eb01e4805bab4091, type: 3}
    - message: The initial is the first letter of a word.
      audio: {fileID: 8300000, guid: fddff666afd00514d82deb0be9805df4, type: 3}
    - message: In today's lesson, every word you type will begin with a capital letter.
      audio: {fileID: 8300000, guid: b0826d8f494c0a04a9ff176e7efbd387, type: 3}
    practiceWord: 
    requireCapitalFirstLetter: 1
    promptMessage: 
    promptAudio: {fileID: 0}
    successMessage: 
