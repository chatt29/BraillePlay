  lessonIntroAudio: {fileID: 8300000, guid: 53df5b85cf486d7499fe34e0a11d1358, type: 3}
  lessonIntroMessage: "Today we're going to find the letter E! Can you hear it? In
    the word bed, we say B-E-D. The E is right in the middle! Let's try another one.
    Leg. L-E-G. Do you hear the E in the middle of leg? One more! Red. R-E-D. E is
    in the middle again! When E is in the middle like this, we call it a C-E-C word.
    That just means consonant, then E, then consonant. You\u2019re ready! Now let\u2019s
    spell some E words together"
  yourScoreIsAudio: {fileID: 8300000, guid: 613a4ecd64752ee4c8844d8286dca545, type: 3}
